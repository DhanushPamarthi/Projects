# Shared PostgreSQL server used by the testiq database. DATABASE_URL can be
# used instead if you prefer a single connection string.
# DATABASE_URL=postgresql://testiq:<password>@10.73.1.56:5432/testiq
TESTIQ_POSTGRES_HOST=10.73.1.56
TESTIQ_POSTGRES_PORT=5432
TESTIQ_POSTGRES_DATABASE=testiq
TESTIQ_POSTGRES_USER=testiq
TESTIQ_POSTGRES_PASSWORD=
# TESTIQ_POSTGRES_SSLMODE=require
BRONZE_SCHEMA=bronzebox
TESTIQ_DATA_DIR=./data
TESTIQ_DB_PATH=./data/testiq.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_GRAPH_MODEL=gpt-4o-mini
OPENAI_RERANKER_MODEL=gpt-4o-mini
PGVECTOR_DIMENSIONS=1536
PGVECTOR_HNSW_EF_SEARCH=100
EXTRACTION_PROMPT_VERSION=brd-extraction-v1
EXTRACTION_CONFIG_VERSION=1.0.0
LOCAL_EXTRACTOR_VERSION=local-parser-v1
# Optional comma-separated expected BRD headings
# REQUIRED_BRD_SECTIONS=Scope,Requirements,Acceptance Criteria
